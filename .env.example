# Local development only. Copy this file to .env, which is untracked, and fill the value in:
#
#   cp .env.example .env
#
# docker compose reads .env automatically. Pick anything — this guards a container bound to
# localhost, not something that protects real data. Use the same value when you set
# ConnectionStrings:Querio in user secrets; the README has the command.
POSTGRES_PASSWORD=
