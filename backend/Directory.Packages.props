<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Runtime -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
    <!-- UI only. The OpenAPI document itself comes from Microsoft.AspNetCore.OpenApi, so
         Swashbuckle is not generating anything — it just renders what we already publish. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <!--
    Transitive pins. Microsoft.AspNetCore.OpenApi resolves Microsoft.OpenApi 2.0.0, which
    carries GHSA-v5pm-xwqc-g5wc. Central transitive pinning lifts it to a patched build.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />
  </ItemGroup>

  <!--
    CQRS dispatch. Mediator is source-generated (no runtime reflection, AOT-safe) and MIT;
    MediatR v13+ moved to a commercial licence.
  -->
  <ItemGroup>
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!--
    Persistence. Application references Microsoft.EntityFrameworkCore so handlers can query
    DbSets directly; the provider (Npgsql) stays in Infrastructure. The boundary we enforce
    is provider-agnostic, not ORM-agnostic — see ArchitectureTests.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- Npgsql 10.0.3 resolves Relational 10.0.4 while EF Core here is 10.0.11. Left alone
         that is an unresolved binding conflict, so pin the whole EF stack to one version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Vector storage and HNSW index DDL. Built against EF Core 9 but supported on 10, which
      was verified against a real database before the schema was designed around it.
    -->
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!--
      R2 speaks the S3 API, so this is the client for it. The same code runs against MinIO in
      tests, which is what lets CI exercise the real storage path without Cloudflare
      credentials.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.2" />
  </ItemGroup>

  <!-- Text extraction. Both permissively licensed, which the free-tier-only rule requires. -->
  <ItemGroup>
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <!--
    Embeddings. Only the abstractions: the transport is our own HTTP client against Gemini's
    native API, because the OpenAI-compatibility layer silently ignores parameters it does not
    support and we depend on two of them. See ADR 0004.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- In the ASP.NET shared framework but not the base one, so a class library needs it. -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.11" />
  </ItemGroup>

  <!-- Abstractions the class libraries need without dragging in the hosting stack. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Coverage for Microsoft.Testing.Platform. coverlet.collector is a VSTest data
         collector and never runs under MTP, which is the runner the .NET 10 SDK uses. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <!-- Real Postgres for integration tests: an in-memory provider cannot verify the
         constraints, indexes and pgvector behaviour we actually depend on. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <!-- Tests mint their own RS256 tokens so the real JwtBearer path runs end to end. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
  </ItemGroup>

</Project>
