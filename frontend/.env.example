# Copy to .env.local for local development. .env.local is gitignored — never commit secrets.

# Base URL of the Querio API. Required in production builds; defaults to the local API port
# during development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5063

# Firebase Web SDK. These are public by design — they ship in every client bundle and
# identify the project rather than authorise anything. Access is controlled by the
# Authorized domains list in the Firebase console, not by keeping these hidden.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
